@using TestWebProjec3T.DAL.Entites
@using TestWebProjec3T.ModelVM.EmployeeVM
@model Employee

@{
    ViewData["Title"] = "Employee Card";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-lg" style="width: 22rem; border-radius: 15px; overflow: hidden;">
        <div class="card-header bg-primary text-white text-center py-3">
            <h4 class="mb-0">Employee Profile</h4>
        </div>
        <div class="card-body text-center">
           
            <div class="mb-3">
                <i class="bi bi-person-circle text-secondary" style="font-size: 4rem;"></i>
            </div>

            <h5 class="card-title fw-bold">@Model.Name</h5>
            <p class="text-muted mb-3">Employee ID: #@Model.Id</p>

            <hr />

            <div class="row text-start px-3">
                <div class="col-6 mb-2">
                    <strong>Age:</strong>
                </div>
                <div class="col-6 mb-2 text-end">
                    <span>@Model.Age years</span>
                </div>

                <div class="col-6 mb-2">
                    <strong>Grade:</strong>
                </div>
                <div class="col-6 mb-2 text-end">
                    <span class="badge bg-info text-dark">Grade @Model.Grade</span>
                </div>
            </div>
        </div>
        <div class="card-footer bg-light text-center py-3">
            <a asp-action="GetAll" class="btn btn-outline-secondary btn-sm me-2">Back to List</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">Edit Profile</a>
        </div>
    </div>
</div>